{
    "version": 2,
    "builds": [
        {
        "src": "web//wsgi.py",
        "use": "@vercel/python"
        },
        {
        "src": "static/**/*",
        "use": "@vercel/static-build",
        "config": {
            "distDir": "staticfiles"
        }
        }
    ],
    "routes": [
        {
        "src": "/static/(.*)",
        "dest": "/static/$1"
        },
        {
        "src": "/(.*)",
        "dest": "web/wsgi.py"
        }
    ]
}